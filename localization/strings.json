    {
      "key": "@meta:setting.enableShiftBypass.name",
      "english": "Bypass keys"
    },
    {
      "key": "@meta:setting.enableShiftBypass.description",
      "english": "Hold Shift while right-clicking to bypass the mod and get the stock classic menu, or Ctrl for the untouched native menu."
    },
    {
      "key": "@meta:setting.instantMenuFade.name",
      "english": "Instant menu open"
    },
    {
      "key": "@meta:setting.instantMenuFade.description",
      "english": "Shows native fallback menus (classic mode, fallbacks) without the system open animation, via TPM_NOANIMATION."
    },
    {
      "key": "@meta:setting.showMoreOptionsItem.name",
      "english": "Show classic menu item"
    },
    {
      "key": "@meta:setting.showMoreOptionsItem.description",
      "english": "Add a \"Show classic menu\" entry at the bottom of the replacement menu."
    },
    {
      "key": "@meta:setting.topBar.name",
      "english": "Top action bar"
    },
    {
      "key": "@meta:setting.topBar.description",
      "english": "Moves Cut, Copy, Paste, Rename and Delete into an icon bar on the side of the menu nearest the cursor, like the Windows 11 menu. Custom menu mode only."
    },
    {
      "key": "@meta:setting.submenuDelayMs.name",
      "english": "Submenu open delay"
    },
    {
      "key": "@meta:setting.submenuDelayMs.description",
      "english": "Milliseconds before a hovered submenu opens while the replacement menu is shown. 0 opens instantly; -1 keeps the Windows setting."
    },
    {
      "key": "@meta:setting.advancedSubmenuWindows.name",
      "english": "Move Windows extras"
    },
    {
      "key": "@meta:setting.advancedSubmenuWindows.description",
      "english": "Move the configured Windows extras into the More options submenu."
    },
    {
      "key": "@meta:setting.advancedSubmenuThirdParty.name",
      "english": "Move third-party handlers"
    },
    {
      "key": "@meta:setting.advancedSubmenuThirdParty.description",
      "english": "Move third-party shell extension entries into the More options submenu."
    },
    {
      "key": "@meta:setting.advancedSubmenuItems.name",
      "english": "Windows items to move"
    },
    {
      "key": "@meta:setting.advancedSubmenuItems.description",
      "english": "Comma-separated labels or verbs of Windows items to move into the submenu. Verbs (for example setdesktopwallpaper) match on every language; labels match the menu's display language. GUID-verb commands also accept the aliases openterminal, editwithphotos, editwithpaint and editwithnotepad."
    },
    {
      "key": "@meta:setting.advancedSubmenuExclude.name",
      "english": "Keep in the main menu"
    },
    {
      "key": "@meta:setting.advancedSubmenuExclude.description",
      "english": "Comma-separated third-party labels or verbs that stay in the main menu instead of moving into the submenu."
    },
    {
      "key": "@meta:setting.advancedSubmenuLabel.name",
      "english": "More options submenu label"
    },
    {
      "key": "@meta:setting.advancedSubmenuLabel.description",
      "english": "Label of the submenu that collects extra items."
    },
    {
      "key": "@meta:setting.settingsHotkey.name",
      "english": "Settings hotkey"
    },
    {
      "key": "@meta:setting.settingsHotkey.description",
      "english": "Optional global hotkey that opens the appearance settings menu (for example Ctrl+Alt+M). Empty disables it."
    },
    {
      "key": "@meta:setting.debugLogging.name",
      "english": "Debug logging"
    },
    {
      "key": "@meta:setting.debugLogging.description",
      "english": "Log timing and diagnostics for troubleshooting."
    },
    {
      "key": "@meta:setting.clearCache.name",
      "english": "Clear cache"
    },
    {
      "key": "@meta:setting.clearCache.description",
      "english": "Turn on to delete the cached menu models; they rebuild on next use."
    },
    {
      "key": "@meta:setting.warmup.name",
      "english": "Background pre-build"
    },
    {
      "key": "@meta:setting.warmup.description",
      "english": "Warms common menus shortly after Explorer starts so their first open is instant. Turning it off skips loading every registered context-menu handler at startup (the stock menu's exposure), which avoids startup crashes from faulty third-party extensions; the first open of each context then builds on demand, like the stock menu. A handler that would crash the stock menu still crashes."
    },
    {
      "key": "@meta:setting.warmupExtensions.name",
      "english": "Warm-up extensions"
    },
    {
      "key": "@meta:setting.warmupExtensions.description",
      "english": "Comma-separated file types whose menus are pre-built at Explorer startup."
    },
    {
      "key": "@meta:setting.warmupDelaySeconds.name",
      "english": "Warm-up delay"
    },
    {
      "key": "@meta:setting.warmupDelaySeconds.description",
      "english": "Seconds to wait after Explorer starts before warming the cache."
    },
    {
      "key": "@meta:language.auto",
      "english": "Automatic (match Windows)"
    }
  ],
